<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.theos</groupId>
        <artifactId>detective-helper</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>desktop</artifactId>
    <packaging>jar</packaging>

    <name>Detective Helper - Desktop</name>
    <description>桌面外壳模块 - JavaFX 窗口 + WebView + 内嵌后端</description>

    <properties>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    </properties>

    <dependencies>
        <!--
          内嵌后端。这是外层的唯一一份业务依赖：
          starter-web / mybatis / sqlite / jgrapht 都由它传递进来，这里不再重复声明。
        -->
        <dependency>
            <groupId>com.theos</groupId>
            <artifactId>backend</artifactId>
        </dependency>

        <!-- JavaFX：-win 分类器 jar 由 openjfx 的 pom 按当前平台自动带上，原生库在里面 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>DetectiveHelper-desktop</finalName>
        <plugins>
            <!--
              fat jar。Start-Class 是 DesktopApplication（JavaFX Application 子类），
              但 jpackage 的 main-class 参数必须传 JarLauncher 而不是它：
              JDK 启动器一看到「主类是 Application 子类 + JavaFX 在 classpath 上」就直接拒绝启动，
              报 "JavaFX runtime components are missing"。由 JarLauncher 反射调用 main 可以绕过这个检查。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.theos.detectivehelper.desktop.DesktopApplication</mainClass>
                    <layers>
                        <enabled>false</enabled>
                    </layers>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 开发期直接跑：mvn -pl desktop javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>com.theos.detectivehelper.desktop.DesktopApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
