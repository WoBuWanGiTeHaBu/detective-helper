<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  日志目录直接用系统属性 ${detectivehelper.data.dir} —— 不能走 <springProperty>：
  Logback 的初始化发生在 ApplicationStartingEvent 阶段，早于 EnvironmentPostProcessor，
  那时候 Spring 的 Environment 还没准备好，读不到属性。

  这里刻意不用 <springProfile>：打包后没有控制台，控制台 appender 留着只是为了
  开发期和冒烟测试能直接看到输出。
-->
<configuration>

    <property name="LOG_DIR" value="${detectivehelper.data.dir:-./data}/logs"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <!-- 不显式指定的话，中文日志在 GBK 控制台上会变成乱码 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
